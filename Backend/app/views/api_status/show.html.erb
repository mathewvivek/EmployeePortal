<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Employee Portal API | Status</title>
    <link rel="icon" type="image/png" href="/api-mark.png">
    <script src="/api-status-theme.js"></script>
    <style>
      :root { color-scheme: light; --background: #f5f8f7; --surface: #fff; --raised: #eef3f0; --text: #243633; --muted: #64766e; --border: #d9e3df; --row-border: #e3eae6; --link: #286c59; --accent: #7251aa; --button-bg: #e7f2ec; --button-hover: #dceee4; --button-border: #b9d5c7; --button-text: #22674e; --status: #328563; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--background); color: var(--text); letter-spacing: 0; }
      :root[data-theme="dark"] { color-scheme: dark; --background: #0b0b0d; --surface: #141416; --raised: #1d1d21; --text: #e7edea; --muted: #a6b1ab; --border: #303035; --row-border: #29292e; --link: #90d1ae; --accent: #b695f6; --button-bg: #183126; --button-hover: #224534; --button-border: #3a604a; --button-text: #a5dabb; --status: #78c49b; }
      * { box-sizing: border-box; }
      body { margin: 0; font-size: 14px; line-height: 1.6; }
      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
      .inner { max-width: 1080px; padding: 0 32px; margin: 0 auto; }
      header { border-bottom: 1px solid var(--border); background: var(--surface); }
      header .inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 88px; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand img { width: 34px; height: 34px; object-fit: contain; }
      .brand strong { display: block; font-size: 16px; font-weight: 600; }
      .brand span { display: block; font-size: 11px; color: var(--muted); }
      nav { display: flex; gap: 23px; align-items: center; font-size: 12px; }
      nav > span { color: var(--text); font-weight: 600; }
      .theme-toggle { display: inline-grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 1px solid var(--border); border-radius: 6px; color: var(--muted); background: transparent; cursor: pointer; flex-shrink: 0; }
      .theme-toggle:hover { background: var(--raised); color: var(--text); }
      .theme-icon { width: 18px; height: 18px; background: currentColor; mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
      .icon-moon { mask-image: url("/api-theme-moon.svg"); }
      .icon-sun { mask-image: url("/api-theme-sun.svg"); display: none; }
      :root[data-theme="dark"] .icon-moon { display: none; }
      :root[data-theme="dark"] .icon-sun { display: block; }
      main { padding-top: 38px !important; padding-bottom: 36px !important; }
      h1 { font-size: 25px; font-weight: 600; line-height: 1.3; margin: 0; }
      h2 { font-size: 17px; font-weight: 600; margin: 0; }
      p { margin: 0; }
      .heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 25px; }
      .heading p { font-size: 12px; color: var(--muted); margin-top: 5px; }
      .portal-link { display: inline-flex; align-items: center; gap: 12px; padding: 10px 17px; border: 1px solid var(--button-border); border-radius: 5px; color: var(--button-text); background: var(--button-bg); font-weight: 600; font-size: 12px; white-space: nowrap; }
      .portal-link:hover { background: var(--button-hover); text-decoration: none; }
      .portal-link span { font-size: 17px; line-height: 1; }
      .status-band { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
      .status { display: flex; align-items: center; gap: 11px; }
      .status-dot { width: 9px; height: 9px; background: var(--status); border-radius: 50%; }
      .status strong { font-size: 15px; font-weight: 600; }
      .status p { font-size: 12px; color: var(--muted); }
      .checked { text-align: right; font-size: 11px; color: var(--muted); }
      .checked time { display: block; color: var(--text); font-size: 12px; font-variant-numeric: tabular-nums; }
      .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; padding: 24px 0; gap: 22px; }
      .facts > div { border-left: 1px solid var(--border); padding-left: 22px; min-width: 0; }
      .facts > div:first-child { border-left: 0; padding-left: 0; }
      dt { font-size: 11px; color: var(--muted); margin-bottom: 7px; }
      dd { margin: 0; font-size: 13px; font-weight: 600; overflow-wrap: anywhere; }
      .health-links { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; margin-top: 10px; border-bottom: 1px solid var(--border); }
      .health-links h2 { font-size: 14px; }
      .health-links p { color: var(--muted); font-size: 11px; margin-top: 3px; }
      .health-links a { font-size: 12px; white-space: nowrap; }
      footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 24px; font-size: 10px; color: var(--muted); }
      @media (max-width: 720px) { .inner { padding-left: 20px; padding-right: 20px; } header .inner { min-height: 78px; } nav { gap: 13px; } .heading { flex-wrap: wrap; gap: 16px; } .status-band { align-items: flex-start; } .checked { max-width: 160px; } .health-links { align-items: flex-start; } }
    </style>
  </head>
  <body>
    <header><div class="inner"><div class="brand"><img src="/api-mark.png" alt="" width="34" height="34"><div><strong>Employee Portal</strong><span>Backend API</span></div></div><nav aria-label="Status navigation"><span aria-current="page">Status</span><%= link_to "JSON", root_path(format: :json) %><%= link_to "Health check", rails_health_check_path %><button id="api-theme-toggle" class="theme-toggle" type="button" aria-label="Switch to black theme" title="Switch to black theme" aria-pressed="false"><span class="theme-icon icon-moon" aria-hidden="true"></span><span class="theme-icon icon-sun" aria-hidden="true"></span></button></nav></div></header>
    <main class="inner">
      <div class="heading"><div><h1>Employee Portal API</h1><p>People and compensation services</p></div><%= link_to @frontend_url, class: "portal-link" do %>Open Employee Portal <span aria-hidden="true">&rarr;</span><% end %></div>
      <section class="status-band" aria-label="Application status"><div class="status"><span class="status-dot" aria-hidden="true"></span><div><strong>Application online</strong><p>Rails is responding</p></div></div><div class="checked">Last checked<time datetime="<%= @checked_at.iso8601 %>"><%= @checked_at.strftime("%d %b %Y, %H:%M:%S UTC") %></time></div></section>
      <dl class="facts"><div><dt>Data access</dt><dd>HR sign-in required</dd></div><div><dt>Database status</dt><dd>Not checked</dd></div></dl>
      <section class="health-links" aria-label="Health monitoring"><div><h2>Health monitoring</h2><p>Application liveness only. Database connectivity is not verified.</p></div><%= link_to "View /up", rails_health_check_path %></section>
      <footer><span>Employee Portal | Backend status</span><span>Employee data requires authentication</span></footer>
    </main>
  </body>
</html>
